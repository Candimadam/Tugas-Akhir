# OUTPUT FOLDER - Ignore ONLY large files NOT needed for web app
# Keep: channel_names.csv, video_metadata.csv, fine_tuning_experiment essentials

# Ignore large embeddings/preprocessed data
output/video_embeddings.npy
output/preprocessed_data.csv

# Ignore baseline model files (not needed)
output/channel_matrix.npy
output/similarity_matrix.npy
output/similarity_matrix.csv
output/evaluation_results.csv

# Ignore advanced_experiment (comparison only, not needed)
output/advanced_experiment/

# Ignore large files in fine_tuning_experiment (can be regenerated)
output/fine_tuning_experiment/video_embeddings_fine_tuned.npy
output/fine_tuning_experiment/train_split.csv
output/fine_tuning_experiment/val_split.csv
output/fine_tuning_experiment/test_split.csv
output/fine_tuning_experiment/training_history.csv

# Ignore model weights (will auto-download or use fine-tuning.ipynb)
output/fine_tuning_experiment/model_fine_tuned/model.safetensors

